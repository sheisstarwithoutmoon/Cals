generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String         @id @default(cuid())
  name                String
  email               String         @unique
  passwordHash        String?
  googleId            String?        @unique
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  age                 Int?
  gender              Gender?
  heightCm            Float?
  currentWeight       Float?
  activityLevel       ActivityLevel?
  goalType            GoalType?
  onboardingCompleted Boolean        @default(false)
  chatMessages        ChatMessage[]
  goal                Goal?
  mealEntries         MealEntry[]
}

model Goal {
  id            String   @id @default(cuid())
  userId        String   @unique
  dailyCalories Float?
  dailyProtein  Float?
  dailyCarbs    Float?
  dailyFat      Float?
  targetWeight  Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MealEntry {
  id             String          @id @default(cuid())
  userId         String
  mealType       MealType
  foodName       String
  quantity       Float?
  quantityUnit   String?
  calories       Float
  protein        Float?
  carbs          Float?
  fat            Float?
  fiber          Float?
  sugar          Float?
  sodium         Float?
  micronutrients Json?
  consumedAt     DateTime
  source         MealSource      @default(MANUAL)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  attachmentUrl  String?
  attachmentType AttachmentType?
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([userId, mealType])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      ChatRole
  content   String
  action    String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum MealSource {
  MANUAL
  AI
  PDF_IMPORT
}

enum AttachmentType {
  IMAGE
  PDF
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum GoalType {
  LOSE
  MAINTAIN
  GAIN
}

enum ChatRole {
  USER
  ASSISTANT
}
