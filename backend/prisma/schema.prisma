generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String          @id @default(cuid())
  name                 String
  email                String          @unique
  passwordHash         String?
  googleId             String?         @unique
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  age                  Int?
  heightCm             Float?
  currentWeight        Float?
  activityLevel        ActivityLevel?
  goalType             GoalType?
  onboardingCompleted  Boolean         @default(false)
  gender               Gender?
  /// Weight the user wants to reach (kg), asked during onboarding for LOSE/GAIN.
  targetWeight         Float?
  /// Planned weight change per week (kg) for LOSE/GAIN; sets the calorie adjustment.
  weeklyWeightChangeKg Float?
  /// Health condition keys the user reported (see body-assessment.service.js).
  healthConditions     String[]        @default([])
  /// When the user answered the health question; null means not asked yet,
  /// which an empty `healthConditions` alone can't express.
  healthReviewedAt     DateTime?
  /// Allergies and food intolerances (e.g. LACTOSE, GLUTEN, NUTS, SOY, EGGS, SHELLFISH, SESAME).
  allergies            String[]        @default([])
  /// Dietary preference (e.g. VEGETARIAN, VEGAN, EGGETARIAN, NON_VEGETARIAN, KETO, OTHER).
  dietPreference       DietPreference?
  chatMessages         ChatMessage[]
  goal                 Goal?
  mealEntries          MealEntry[]
}

model Goal {
  id            String   @id @default(cuid())
  userId        String   @unique
  dailyCalories Float?
  dailyProtein  Float?
  dailyCarbs    Float?
  dailyFat      Float?
  targetWeight  Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MealEntry {
  id             String          @id @default(cuid())
  userId         String
  mealType       MealType
  foodName       String
  quantity       Float?
  quantityUnit   String?
  calories       Float
  protein        Float?
  carbs          Float?
  fat            Float?
  fiber          Float?
  sugar          Float?
  sodium         Float?
  micronutrients Json?
  consumedAt     DateTime
  source         MealSource      @default(MANUAL)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  attachmentUrl  String?
  attachmentType AttachmentType?
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          MealItem[]

  @@index([userId, consumedAt])
  @@index([userId, mealType])
}

/// One food item within a meal. The parent MealEntry's nutrition fields hold
/// the sum of its items, so totals/reports never need to join this table.
model MealItem {
  id             String    @id @default(cuid())
  mealEntryId    String
  position       Int       @default(0)
  name           String
  quantity       Float?
  quantityUnit   String?
  calories       Float
  protein        Float?
  carbs          Float?
  fat            Float?
  fiber          Float?
  sugar          Float?
  sodium         Float?
  micronutrients Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  mealEntry      MealEntry @relation(fields: [mealEntryId], references: [id], onDelete: Cascade)

  @@index([mealEntryId, position])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      ChatRole
  content   String
  action    String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum MealSource {
  MANUAL
  AI
  PDF_IMPORT
}

enum AttachmentType {
  IMAGE
  PDF
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum GoalType {
  LOSE
  MAINTAIN
  GAIN
}

enum ChatRole {
  USER
  ASSISTANT
}

enum DietPreference {
  VEGETARIAN
  VEGAN
  EGGETARIAN
  NON_VEGETARIAN
  KETO
  OTHER
}
